# Copy this file to `.env.local` for local development.
# Values prefixed with VITE_ are bundled into the browser and must be safe to expose.

# Supabase project settings
# Find both values in Supabase Dashboard -> Project Settings / Connect.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Public URL that Supabase should return to after Google OAuth.
# In Supabase Auth -> URL Configuration, set Site URL to this value and add it
# to Redirect URLs.
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# Google permission requested through Supabase Auth. Keep this send-only.
VITE_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send

# Leave blank locally so Vite proxies /api to FastAPI. In Vercel, set this to
# the Cloud Run service URL, without a trailing slash.
VITE_API_BASE_URL=

# Do not put these server-only values in this frontend file:
# - SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY
# - Google OAuth client secret
# Configure the Google client ID and client secret in Supabase Dashboard:
# Authentication -> Providers -> Google. The Google authorized redirect URI is
# the Supabase callback URL shown on that page.
