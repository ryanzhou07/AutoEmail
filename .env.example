# Copy this file to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# Get these from Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Application type: Desktop app.
# Also enable the Gmail API for the project.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_PROJECT_ID=your-gcp-project-id

# Alternative: point at a downloaded client_secret.json instead of the two values above.
# (credentials/ is gitignored.)
# GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json

# Where the OAuth token is cached after you click "Connect Gmail". (storage/ is gitignored.)
GOOGLE_TOKEN_PATH=storage/token.json
